// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "mysql"
}

// ═══════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════

enum ActorType {
  SYSTEM_ADMIN
  HOTEL_ADMIN
  HOTEL_SUB_ADMIN
  END_USER
}

enum AmenityContext {
  HOTEL   // shown on hotel listing / hotel detail page amenity section
  ROOM    // shown on room type detail / room properties
}

enum ApprovalStatus {
  UNPUBLISHED  // created by system admin; not public
  PUBLISHED    // hotel admin published; visible on site
  SUSPENDED    // system admin suspended; hidden from public
}

enum BookingStatus {
  RESERVED     // 10-min hold; awaiting payment
  BOOKED       // payment confirmed
  EXPIRED      // 10-min window passed without payment
  CANCELLED    // cancelled by user or hotel staff
  CHECKED_IN   // set manually by hotel staff on guest arrival
  CHECKED_OUT  // set manually by hotel staff on departure
  NO_SHOW      // set manually by hotel staff
}

enum TrackerStatus {
  RESERVED
  BOOKED
  EXPIRED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

enum RoomStatus {
  AVAILABLE     // no active booking for today; default resting state
  BOOKED        // auto-set when a room_tracker covers today (RESERVED/BOOKED)
  CHECKED_IN    // set manually by hotel staff on guest arrival (mirrors room_trackers)
  CHECKED_OUT   // set manually by hotel staff on departure (mirrors room_trackers)
  MAINTENANCE   // manual override; room taken out of service
}

enum CaseStatus {
  DRAFTING   // accumulating staged edits, not yet submitted, invisible to Review Queue
  PENDING    // submitted, awaiting System Admin decision
  APPROVED
  REJECTED
}

enum FieldChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentType {
  TRADE_LICENSE
  TAX_CERTIFICATE
  TIN_CERTIFICATE
  VAT_CERTIFICATE
  BUSINESS_DOCUMENT
  OWNER_DOCUMENT
  ADMIN_DOCUMENT
}

// Which live table a case_field_changes row is proposing a change against.
// No DB-level FK to the target table (a row can describe a brand new record
// that doesn't exist yet) — validated at the application layer instead.
enum CaseEntityType {
  HOTEL              // hotels + hotel_details fields
  HOTEL_OWNER        // hotel_owner_details
  HOTEL_ADMIN        // hotel_admin_details identity fields (name/phone/dob/nid/passport/address/photo). NOT email (immutable, no change path exists) or password (immediate, no review).
  HOTEL_IMAGE        // hotel_images (gallery)
  HOTEL_DOCUMENT     // hotel_documents
  AMENITY            // a hotel's or room type's amenity SELECTION only — amenities themselves are fully global/System-Admin-owned now, same as bed types, so there's no "creating a new custom amenity" case anymore
  POLICY             // policies
  // ROOM_TYPE, ROOM_TYPE_IMAGE, ROOM_FACILITY, ROOM_DETAIL removed —
  // Room Type / Room Variant / Physical Room management is direct Hotel
  // Admin CRUD now (see room-variant-matching.ts), never case-reviewed.
  // Confirmed zero code references before removal — case-engine.ts's
  // applyFieldChange branches for these were removed in the same pass.
  // BED_TYPE removed — bed types are now fully global/System-Admin-owned (no
  // hotel-custom creation path at all), so there's nothing left for Hotel
  // Admin to propose here.
}

enum NotificationType {
  CASE_SUBMITTED
  CASE_APPROVED
  CASE_REJECTED
  FIELD_REJECTED
  NEW_BOOKING
  BOOKING_CANCELLED
  NEW_REVIEW
  DOCUMENT_EXPIRING
  ACCOUNT_BLOCKED
  MASTER_DATA_REQUEST  // a Hotel Admin submitted, or a System Admin resolved, a master data request — NOT a case, deliberately separate from CASE_SUBMITTED
  GENERAL
}

// CancellationPolicy enum removed — cancellation policy fields were dropped
// from both hotel_details and room_types per your instruction; nothing
// references this enum anymore.

// ═══════════════════════════════════════════════════════
// ROLES
// Seeded: id=1 HOTEL_ADMIN, id=2 HOTEL_SUB_ADMIN
// Only used by hotel_admins and hotel_sub_admins tables.
// ═══════════════════════════════════════════════════════

model roles {
  id               Int                @id @default(autoincrement())
  role_name        String             @unique @db.VarChar(50)
  created_at       DateTime           @default(now())
  deleted_at       DateTime?
  hotel_admins     hotel_admins[]
  hotel_sub_admins hotel_sub_admins[]

  @@map("roles")
}

// ═══════════════════════════════════════════════════════
// SYSTEM ADMINS
// A system admin can create other system admins (self-reference).
// ═══════════════════════════════════════════════════════

model system_admins {
  id                     Int                   @id @default(autoincrement())
  name                   String                @db.VarChar(150)
  email                  String                @unique @db.VarChar(255)
  password               String                @db.VarChar(255)
  is_active              Boolean               @default(true)
  is_blocked             Boolean               @default(false)
  created_by             Int?
  last_login_at          DateTime?
  login_attempts         Int                   @default(0)
  locked_until           DateTime?
  password_reset_token   String?               @db.VarChar(255)
  password_reset_expires DateTime?
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt
  deleted_at             DateTime?

  creator              system_admins?        @relation("AdminCreatedBy", fields: [created_by], references: [id])
  created_admins       system_admins[]       @relation("AdminCreatedBy")
  detail               system_admin_details?
  images               system_admin_images[]
  hotels_created       hotels[]              @relation("HotelCreatedBy")
  hotel_admins_created hotel_admins[]        @relation("HotelAdminCreatedBy")
  cases_decided        cases[]               @relation("CaseDecidedBy")

  @@index([email])
  @@index([created_by])
  @@map("system_admins")
}

model system_admin_details {
  id              Int           @id @default(autoincrement())
  system_admin_id Int           @unique
  dob             DateTime?     @db.Date
  gender          String?       @db.VarChar(20)
  address         String?       @db.Text
  nid_no          String?       @db.VarChar(50)
  passport        String?       @db.VarChar(50)
  phone           String?       @db.VarChar(32)
  updated_at      DateTime      @updatedAt
  system_admin    system_admins @relation(fields: [system_admin_id], references: [id], onDelete: Cascade)

  @@map("system_admin_details")
}

model system_admin_images {
  id              Int           @id @default(autoincrement())
  system_admin_id Int
  image_url       String        @db.VarChar(500)
  is_active       Boolean       @default(true)
  created_at      DateTime      @default(now())
  system_admin    system_admins @relation(fields: [system_admin_id], references: [id], onDelete: Cascade)

  @@index([system_admin_id])
  @@map("system_admin_images")
}

// ═══════════════════════════════════════════════════════
// END USERS
// password nullable to support Google OAuth later.
// ═══════════════════════════════════════════════════════

model end_users {
  id                     Int                @id @default(autoincrement())
  email                  String             @unique @db.VarChar(255)
  password               String?            @db.VarChar(255)
  name                   String             @db.VarChar(150)
  email_verified         Boolean            @default(false)
  email_verified_at      DateTime?
  is_active              Boolean            @default(true)
  is_blocked             Boolean            @default(false)
  last_login_at          DateTime?
  login_attempts         Int                @default(0)
  locked_until           DateTime?
  password_reset_token   String?            @db.VarChar(255)
  password_reset_expires DateTime?
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt
  deleted_at             DateTime?

  detail   end_user_details?
  images   end_user_images[]
  bookings user_bookings[]

  @@index([email])
  @@map("end_users")
}

model end_user_details {
  id                Int       @id @default(autoincrement())
  end_user_id       Int       @unique
  dob               DateTime? @db.Date
  gender            String?   @db.VarChar(20)
  address           String?   @db.Text
  country           String?   @default("Bangladesh") @db.VarChar(100)
  nid_no            String?   @db.VarChar(50)
  passport          String?   @db.VarChar(50)
  phone             String?   @db.VarChar(32)
  emergency_contact String?   @db.VarChar(100)
  updated_at        DateTime  @updatedAt
  end_user          end_users @relation(fields: [end_user_id], references: [id], onDelete: Cascade)

  @@map("end_user_details")
}

model end_user_images {
  id          Int       @id @default(autoincrement())
  end_user_id Int
  image_url   String    @db.VarChar(500)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  end_user    end_users @relation(fields: [end_user_id], references: [id], onDelete: Cascade)

  @@index([end_user_id])
  @@map("end_user_images")
}

// ═══════════════════════════════════════════════════════
// CITIES
// Pre-seeded with major BD cities. Managed by system admin.
// Hotels reference city_id FK — no free-text city strings.
// image_url used for browse-by-city tiles on the homepage.
// ═══════════════════════════════════════════════════════

model cities {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  image_url  String?  @db.VarChar(500)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  hotels     hotels[]

  @@map("cities")
}

// ═══════════════════════════════════════════════════════
// HOTEL TYPES
// Seeded defaults: Hotel, Resort, Boutique, Hostel, Guest House, Serviced Apartment
// Managed by system admin only.
// ═══════════════════════════════════════════════════════

model hotel_types {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  hotels     hotels[]

  @@map("hotel_types")
}

// ═══════════════════════════════════════════════════════
// HOTELS
// Created by system admin alongside the hotel admin account (single form).
// System admin edits hotel-level info (NOT rooms or room types).
// Hotel admin edits hotel-level info AND owns all room/room type management.
// city_id is a FK — no free-text city. Always chosen from cities dropdown.
// ═══════════════════════════════════════════════════════

model hotels {
  id                 Int            @id @default(autoincrement())
  name               String         @db.VarChar(255)
  slug               String         @unique @db.VarChar(255)
  email              String?        @db.VarChar(150)
  address            String?        @db.Text
  city_id            Int?
  hotel_type_id      Int?
  zip_code           String?        @db.VarChar(20)
  map_location       String?        @db.Text  // full Google Maps / location URLs can exceed 500 chars
  created_by         Int
  approval_status    ApprovalStatus @default(UNPUBLISHED)
  published_at       DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  deleted_at         DateTime?

  city             cities?            @relation(fields: [city_id], references: [id])
  hotel_type       hotel_types?       @relation(fields: [hotel_type_id], references: [id])
  creator          system_admins      @relation("HotelCreatedBy", fields: [created_by], references: [id])
  hotel_admin      hotel_admins?
  detail           hotel_details?
  images           hotel_images[]
  hotel_amenities  hotel_amenities[]
  hotel_sub_admins hotel_sub_admins[]
  room_types       room_types[]
  bookings         user_bookings[]
  owner_detail     hotel_owner_details?
  documents        hotel_documents[]
  policies         policies[]
  cases            cases[]
  master_data_requests master_data_requests[]

  @@index([approval_status])
  @@index([city_id])
  @@index([hotel_type_id])
  @@index([created_by])
  @@map("hotels")
}

model hotel_details {
  id                      Int                @id @default(autoincrement())
  hotel_id                Int                @unique
  description             String?            @db.Text
  reception_no1           String?            @db.VarChar(32)
  reception_no2           String?            @db.VarChar(32)
  star_rating             Decimal?           @db.Decimal(2, 1)
  guest_rating            Decimal            @default(0.00) @db.Decimal(3, 2)
  website                 String?            @db.VarChar(255)
  check_in_time           String             @default("14:00") @db.VarChar(5)
  check_out_time          String             @default("12:00") @db.VarChar(5)
  advance_deposit_percent Int                @default(0)
  // Emergency contact — property-level point of contact for critical incidents.
  // Distinct from hotel_admin_details.emergency_contact1/2, which is the admin's own personal contact.
  emergency_contact_name        String?      @db.VarChar(150)
  emergency_contact_designation String?      @db.VarChar(100)
  emergency_contact_phone1      String?      @db.VarChar(32)
  emergency_contact_phone2      String?      @db.VarChar(32)
  emergency_contact_email       String?      @db.VarChar(150)
  updated_at              DateTime           @updatedAt
  hotel                   hotels             @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@map("hotel_details")
}

model hotel_images {
  id         Int      @id @default(autoincrement())
  hotel_id   Int
  image_url  String   @db.MediumText
  is_cover   Boolean  @default(false)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  hotel      hotels   @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@index([hotel_id])
  @@map("hotel_images")
}

// ═══════════════════════════════════════════════════════
// HOTEL ADMINS
// Created simultaneously with the hotel by system admin.
// One hotel <-> one hotel admin (@unique on hotel_id).
// ═══════════════════════════════════════════════════════

model hotel_admins {
  id                     Int                  @id @default(autoincrement())
  role_id                Int                  @default(1)
  hotel_id               Int                  @unique
  created_by             Int?
  name                   String               @db.VarChar(150)
  email                  String               @unique @db.VarChar(255)
  password               String               @db.VarChar(255)
  is_active              Boolean              @default(true)
  is_blocked             Boolean              @default(false)
  last_login_at          DateTime?
  login_attempts         Int                  @default(0)
  locked_until           DateTime?
  password_reset_token   String?              @db.VarChar(255)
  password_reset_expires DateTime?
  created_at             DateTime             @default(now())
  updated_at             DateTime             @updatedAt
  deleted_at             DateTime?

  role               roles                @relation(fields: [role_id], references: [id])
  hotel              hotels               @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  creator            system_admins?       @relation("HotelAdminCreatedBy", fields: [created_by], references: [id])
  detail             hotel_admin_details?
  images             hotel_admin_images[]
  created_sub_admins hotel_sub_admins[]   @relation("SubAdminCreatedBy")
  cases_submitted    cases[]              @relation("CaseSubmittedBy")

  @@index([email])
  @@index([created_by])
  @@index([role_id])
  @@map("hotel_admins")
}

model hotel_admin_details {
  id                 Int          @id @default(autoincrement())
  hotel_admin_id     Int          @unique
  dob                DateTime?    @db.Date
  phone              String?      @db.VarChar(32)
  nid_no             String?      @db.VarChar(50)
  passport           String?      @db.VarChar(50)
  address            String?      @db.Text
  manager_name       String?      @db.VarChar(150)
  manager_phone      String?      @db.VarChar(32)
  emergency_contact1 String?      @db.VarChar(100)
  emergency_contact2 String?      @db.VarChar(100)
  updated_at         DateTime     @updatedAt
  hotel_admin        hotel_admins @relation(fields: [hotel_admin_id], references: [id], onDelete: Cascade)

  @@map("hotel_admin_details")
}

model hotel_admin_images {
  id             Int          @id @default(autoincrement())
  hotel_admin_id Int
  image_url      String       @db.VarChar(500)
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now())
  hotel_admin    hotel_admins @relation(fields: [hotel_admin_id], references: [id], onDelete: Cascade)

  @@index([hotel_admin_id])
  @@map("hotel_admin_images")
}

// ═══════════════════════════════════════════════════════
// HOTEL SUB ADMINS
// Created by hotel admin for their own hotel.
// Permissions: room availability/status updates, handle bookings ONLY.
// Cannot: create/delete rooms, manage room types, manage amenities/bed types,
// manage staff, set pricing, or submit anything to the case system.
// created_by -> hotel_admins.id (FK with onDelete: SetNull)
// Soft delete via deleted_at — hard delete never used.
// ═══════════════════════════════════════════════════════

model hotel_sub_admins {
  id                     Int                      @id @default(autoincrement())
  role_id                Int                      @default(2)
  hotel_id               Int
  created_by             Int?
  name                   String                   @db.VarChar(150)
  email                  String                   @unique @db.VarChar(255)
  password               String                   @db.VarChar(255)
  is_active              Boolean                  @default(true)
  is_blocked             Boolean                  @default(false)
  last_login_at          DateTime?
  login_attempts         Int                      @default(0)
  locked_until           DateTime?
  password_reset_token   String?                  @db.VarChar(255)
  password_reset_expires DateTime?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  deleted_at             DateTime?

  role    roles                    @relation(fields: [role_id], references: [id])
  hotel   hotels                   @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  creator hotel_admins?            @relation("SubAdminCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  detail  hotel_sub_admin_details?
  images  hotel_sub_admin_images[]

  @@index([email])
  @@index([hotel_id])
  @@index([created_by])
  @@index([role_id])
  @@index([is_blocked])
  @@index([deleted_at])
  @@map("hotel_sub_admins")
}

model hotel_sub_admin_details {
  id                 Int              @id @default(autoincrement())
  hotel_sub_admin_id Int              @unique
  phone              String?          @db.VarChar(32)
  nid_no             String?          @db.VarChar(50)
  passport           String?          @db.VarChar(50)
  address            String?          @db.Text
  updated_at         DateTime         @updatedAt
  hotel_sub_admin    hotel_sub_admins @relation(fields: [hotel_sub_admin_id], references: [id], onDelete: Cascade)

  @@map("hotel_sub_admin_details")
}

model hotel_sub_admin_images {
  id                 Int              @id @default(autoincrement())
  hotel_sub_admin_id Int
  image_url          String           @db.VarChar(500)
  is_active          Boolean          @default(true)
  created_at         DateTime         @default(now())
  hotel_sub_admin    hotel_sub_admins @relation(fields: [hotel_sub_admin_id], references: [id], onDelete: Cascade)

  @@index([hotel_sub_admin_id])
  @@map("hotel_sub_admin_images")
}

// ═══════════════════════════════════════════════════════
// AMENITIES
// Fully global, System-Admin-owned — no hotel_id, no is_default. Hotel Admin
// only selects from this list (at the hotel level via hotel_amenities, or at
// the room-type level via room_type_amenities); if what they need doesn't
// exist, they submit a master_data_requests entry (category: AMENITY)
// instead of creating their own. Same pattern as bed_types/room_facilities.
// context: HOTEL = hotel-level features, ROOM = room-level features.
// icon = a lucide-react icon name (e.g. "Wifi", "Car"), not a slug.
// ═══════════════════════════════════════════════════════

model amenities {
  id         Int            @id @default(autoincrement())
  name       String         @db.VarChar(150)
  icon       String?        @db.VarChar(100)
  context    AmenityContext
  is_active  Boolean        @default(true)
  created_at DateTime       @default(now())

  hotel_amenities     hotel_amenities[]
  room_type_amenities room_type_amenities[]

  @@unique([name, context])
  @@index([context])
  @@map("amenities")
}

model hotel_amenities {
  id         Int       @id @default(autoincrement())
  hotel_id   Int
  amenity_id Int
  created_at DateTime  @default(now())
  hotel      hotels    @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  amenity    amenities @relation(fields: [amenity_id], references: [id], onDelete: Cascade)

  @@unique([hotel_id, amenity_id])
  @@index([hotel_id])
  @@index([amenity_id])
  @@map("hotel_amenities")
}

// ═══════════════════════════════════════════════════════
// BED TYPES
// Fully global, System-Admin-owned — no hotel_id, no is_default. Bed types
// (King/Queen/Single/etc.) are universal; hotel-specific duplicates of the
// same concept added no value. Hotel Admin selects from this list when
// building a room; if what they need doesn't exist, they submit a
// master_data_requests entry (category: BED_TYPE) instead of creating their
// own — same pattern as room_facilities.
// ═══════════════════════════════════════════════════════

model bed_types {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique @db.VarChar(100)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now())

  room_variant_bed_types room_variant_bed_types[]

  @@map("bed_types")
}

// ═══════════════════════════════════════════════════════
// ROOM TYPES
// Always hotel-owned now (hotel_id required) — there is no more System-Admin
// global template concept. A room type is real content specific to one
// hotel, unlike amenities/bed_types/room_facilities which are genuine
// reusable master data. Creating one is a whole-new-record case proposal
// bundling name + description + room-level amenity selection
// (room_type_amenities, using amenities with context: ROOM — e.g. mini bar,
// safe, hair dryer) all together; editing one later is reviewed the same way.
// System Admin never authors a room type directly, but can see every hotel's
// room types (read-only, via the case system / hotel workspace).
// Does NOT carry bed configuration (physical room level), pricing, occupancy,
// or facilities (all physical room level) — a room type is purely a name/
// description/amenities classification.
// ═══════════════════════════════════════════════════════

model room_types {
  id          Int      @id @default(autoincrement())
  hotel_id    Int
  name        String   @db.VarChar(150)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  hotel               hotels                @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  room_variants       room_variants[]
  type_images         room_images[]         @relation("RoomTypeImages")
  room_type_amenities room_type_amenities[]
  room_bookings       room_bookings[]

  @@unique([hotel_id, name])
  @@index([hotel_id])
  @@index([is_active])
  @@map("room_types")
}

// ═══════════════════════════════════════════════════════
// ROOM FACILITIES
// Fully global, System-Admin-owned — no hotel_id, no is_default, same as
// amenities and bed_types. Hotel Admin only selects from what's available
// (per room variant — room_variant_facilities); if nothing fits, they
// submit a master_data_requests entry (category: ROOM_FACILITY).
// Structural/physical properties (AC, smoking allowed, pet allowed,
// balcony, etc.), not marketing amenities.
// Selection now lives on room_variants, set directly by Hotel Admin —
// immediate, NOT case-reviewed (see room_variants above).
// ═══════════════════════════════════════════════════════

model room_facilities {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  room_variant_facilities room_variant_facilities[]

  @@map("room_facilities")
}

// room_detail_facilities and room_detail_bed_types (the old physical-room-
// level junction tables) were removed here — nothing references them
// anymore now that facilities/beds live on room_variants instead. No live
// data existed under the old shape (room creation was never successfully
// exercised end-to-end through the old case-based flow), so there's
// nothing to migrate off of them.


// ═══════════════════════════════════════════════════════
// MASTER DATA REQUESTS
// "Can't find the amenity/bed type/room type/facility you need? Send a request."
// Hotel Admin flags what's missing; System Admin gets notified. This is NOT
// the case/review system — it's not proposing a change to THIS hotel's
// content, it's asking System Admin to make something new available.
// REVISED: fulfilling a request does NOT auto-generate a row from the note
// text. System Admin is taken to the real creation page for that category
// (Amenities/Bed Types/Room Types/Room Facilities) and builds the entry
// properly there; that creation action is what sets created_entity_id and
// flips this row to FULFILLED, rather than a standalone atomic "fulfill" step.
// ═══════════════════════════════════════════════════════

model master_data_requests {
  id                Int                     @id @default(autoincrement())
  hotel_id          Int
  requested_by      Int                     // hotel_admins.id
  category          MasterDataCategory
  name              String                  @db.VarChar(150) // the requested item's name, e.g. "Rollaway Bed"
  context           AmenityContext?         // only set when category = AMENITY (Hotel vs Room amenity)
  note              String                  @db.Text
  status            MasterDataRequestStatus @default(PENDING)
  resolved_by       Int?                    // system_admins.id
  resolved_at       DateTime?
  resolution_note   String?                 @db.Text // dismissal reason; also usable for a short fulfillment note if ever needed
  created_entity_id Int?                    // id of the row created via the normal creation page when this request is fulfilled — not auto-generated. No DB-level FK since it's polymorphic across three tables (amenities/bed_types/room_facilities).
  created_at        DateTime                @default(now())

  hotel hotels @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@index([hotel_id])
  @@index([status])
  @@map("master_data_requests")
}

enum MasterDataCategory {
  AMENITY
  BED_TYPE
  ROOM_FACILITY
  // ROOM_TYPE is intentionally NOT here — Room Types are hotel-owned and
  // created/edited directly by Hotel Admin (immediate, no review of any
  // kind), so there's no global template to request. This is unrelated to
  // Case Review, which also no longer applies to Room Type management.
}

enum MasterDataRequestStatus {
  PENDING
  FULFILLED
  DISMISSED
}

model room_type_amenities {
  id           Int        @id @default(autoincrement())
  room_type_id Int
  amenity_id   Int
  created_at   DateTime   @default(now())
  room_type    room_types @relation(fields: [room_type_id], references: [id], onDelete: Cascade)
  amenity      amenities  @relation(fields: [amenity_id], references: [id], onDelete: Cascade)

  @@unique([room_type_id, amenity_id])
  @@index([room_type_id])
  @@map("room_type_amenities")
}

// ═══════════════════════════════════════════════════════
// ROOM DETAILS  (physical room instances)
// Creation/editing is direct Hotel Admin CRUD — immediate, NOT
// case-reviewed. Room number is unique hotel-wide (enforced in the API
// layer). Variant-defining fields (price/size/occupancy/facilities/beds)
// now live on room_variants — this table only holds room_number, floor,
// status, and notes. See room_variants above for the matching logic.
// ═══════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════
// ROOM VARIANTS  (guest-facing sellable configuration)
// Sits between room_types (broad category) and room_details (physical
// inventory). Auto-created/reused — Hotel Admin never manages this
// directly. signature_hash is a deterministic hash of every field that
// defines the variant (price, room_size, max_occupancy, facility set, bed
// set) — NOT images. @@unique([room_type_id, signature_hash]) is the
// concurrency guard: two concurrent room creations with the same config
// resolve to the same row via upsert instead of racing into duplicates.
// Direct Hotel Admin CRUD, NOT case-reviewed — see room_details below.
// ═══════════════════════════════════════════════════════

model room_variants {
  id             Int      @id @default(autoincrement())
  room_type_id   Int
  signature_hash String   @db.VarChar(64)
  price          Decimal  @db.Decimal(12, 2)
  room_size      String?  @db.VarChar(50)
  max_occupancy  Int?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  room_type      room_types                @relation(fields: [room_type_id], references: [id], onDelete: Cascade)
  room_details   room_details[]
  room_bookings  room_bookings[]
  variant_images room_images[]             @relation("RoomVariantImages")
  facilities     room_variant_facilities[]
  bed_types      room_variant_bed_types[]
  pricing_rules  pricing_rules[]

  @@unique([room_type_id, signature_hash])
  @@index([room_type_id])
  @@map("room_variants")
}

model room_variant_facilities {
  id              Int      @id @default(autoincrement())
  room_variant_id Int
  facility_id     Int
  created_at      DateTime @default(now())

  room_variant room_variants   @relation(fields: [room_variant_id], references: [id], onDelete: Cascade)
  facility     room_facilities @relation(fields: [facility_id], references: [id], onDelete: Cascade)

  @@unique([room_variant_id, facility_id])
  @@index([room_variant_id])
  @@map("room_variant_facilities")
}

model room_variant_bed_types {
  id              Int      @id @default(autoincrement())
  room_variant_id Int
  bed_type_id     Int
  count           Int      @default(1)
  created_at      DateTime @default(now())

  room_variant room_variants @relation(fields: [room_variant_id], references: [id], onDelete: Cascade)
  bed_type     bed_types     @relation(fields: [bed_type_id], references: [id])

  @@unique([room_variant_id, bed_type_id])
  @@index([room_variant_id])
  @@map("room_variant_bed_types")
}

// ═══════════════════════════════════════════════════════
// ROOM DETAILS  (physical room instances — actual inventory)
// Direct Hotel Admin CRUD, immediate, NOT case-reviewed. Creating or
// editing a room's variant-defining fields (price/size/occupancy/
// facilities/beds) triggers signature matching against room_variants —
// see /lib/room-variant-matching.ts. Only room_number/floor/status/notes
// live here now; everything guest-facing moved to room_variants.
// Room number is unique HOTEL-WIDE (across all types/variants), not just
// within one room type — enforced in the API layer since the hotel_id
// isn't a direct column here (reachable via room_variant -> room_type).
// ═══════════════════════════════════════════════════════

model room_details {
  id              Int        @id @default(autoincrement())
  room_variant_id Int
  room_number     String     @db.VarChar(50)
  floor           Int?
  status          RoomStatus @default(AVAILABLE)
  notes           String?    @db.Text
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  deleted_at      DateTime?

  room_variant  room_variants  @relation(fields: [room_variant_id], references: [id])
  room_images   room_images[]  @relation("RoomDetailImages")
  room_trackers room_trackers[]
  room_bookings room_bookings[]

  @@unique([room_variant_id, room_number, deleted_at])
  @@index([room_variant_id])
  @@index([status])
  @@map("room_details")
}

// ═══════════════════════════════════════════════════════
// ROOM IMAGES
// Exactly ONE of room_type_id / room_variant_id / room_detail_id is set:
//   room_type_id    → shared image for the room type's marketing page
//   room_variant_id → shared image for every physical room in that variant
//                     (the default, guest-facing gallery)
//   room_detail_id  → optional extra photo for one specific physical room
//                     (rare — not required by the variant model, kept for
//                     flexibility, unused by default)
// ═══════════════════════════════════════════════════════

model room_images {
  id              Int            @id @default(autoincrement())
  image_url       String         @db.LongText
  is_cover        Boolean        @default(false)
  sort_order      Int            @default(0)
  room_type_id    Int?
  room_variant_id Int?
  room_detail_id  Int?
  created_at      DateTime       @default(now())

  room_type    room_types?    @relation("RoomTypeImages", fields: [room_type_id], references: [id], onDelete: Cascade)
  room_variant room_variants? @relation("RoomVariantImages", fields: [room_variant_id], references: [id], onDelete: Cascade)
  room_detail  room_details?  @relation("RoomDetailImages", fields: [room_detail_id], references: [id], onDelete: Cascade)

  @@index([room_type_id])
  @@index([room_variant_id])
  @@index([room_detail_id])
  @@map("room_images")
}

// ═══════════════════════════════════════════════════════
// PRICING RULES  (temporary discount on a room variant)
// room_variants.price is the variant's base rate. A pricing_rules row is
// an active discount override for EVERY room in that variant, valid until
// end_date — after which it reverts to room_variants.price automatically.
// ═══════════════════════════════════════════════════════

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PricingRuleStatus {
  ACTIVE
  PAUSED
  // EXPIRED is intentionally NOT stored — a rule naturally stops applying
  // once end_date passes. The resolver checks the date range at query
  // time; "expired" is a derived, display-only state, never persisted.
}

// ═══════════════════════════════════════════════════════
// PRICING RULES  (offers/discounts on a room variant's base price)
// room_variants.price is the single source of truth for the undiscounted
// nightly rate. A pricing_rule never stores a replacement price — only a
// discount to apply against whatever the base price currently is. See
// src/lib/pricing-resolver.ts for the actual resolution logic (highest-
// priority ACTIVE rule whose date range covers the stay date wins — no
// stacking). Direct Hotel Admin CRUD, NOT case-reviewed.
// ═══════════════════════════════════════════════════════

model pricing_rules {
  id             Int               @id @default(autoincrement())
  room_variant_id Int
  name           String            @db.VarChar(150)
  description    String?           @db.Text
  discount_type  DiscountType
  discount_value Decimal           @db.Decimal(12, 2) // percentage (0-100) or a fixed amount, per discount_type
  status         PricingRuleStatus @default(ACTIVE)
  priority       Int               @default(0) // higher wins when multiple rules apply to the same date
  start_date     DateTime          @db.Date
  end_date       DateTime          @db.Date
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt
  room_variant   room_variants     @relation(fields: [room_variant_id], references: [id], onDelete: Cascade)

  @@index([room_variant_id])
  @@index([start_date, end_date])
  @@index([status])
  @@map("pricing_rules")
}

// ═══════════════════════════════════════════════════════
// USER BOOKINGS
// One booking = one hotel, one check-in/out window.
// Can hold multiple rooms (one room_bookings row per physical room).
// booking_reference generated at RESERVATION time.
// reserved_until = now + 10 min. Cleared after payment.
// No children — guests (adults) + rooms count only.
// ═══════════════════════════════════════════════════════

model user_bookings {
  id                Int           @id @default(autoincrement())
  booking_reference String        @unique @db.VarChar(64)
  end_user_id       Int
  hotel_id          Int
  check_in          DateTime      @db.Date
  check_out         DateTime      @db.Date
  guests            Int           @default(1)
  rooms_count       Int           @default(1)
  special_request   String?       @db.Text
  status            BookingStatus @default(RESERVED)
  reserved_until    DateTime?
  total_price       Decimal       @db.Decimal(12, 2)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  end_user      end_users       @relation(fields: [end_user_id], references: [id], onDelete: Cascade)
  hotel         hotels          @relation(fields: [hotel_id], references: [id])
  room_bookings room_bookings[]
  room_trackers room_trackers[]

  @@index([booking_reference])
  @@index([end_user_id, status])
  @@index([hotel_id, check_in, check_out])
  @@index([reserved_until])
  @@map("user_bookings")
}

// price_per_night stays as an average (subtotal / nights) for quick
// display in lists/receipts where a full breakdown isn't needed —
// subtotal itself is always SUM(room_booking_nightly_rates.price), the
// authoritative total. The real per-night snapshot lives below.
model room_bookings {
  id              Int          @id @default(autoincrement())
  booking_id      Int
  room_type_id    Int
  room_variant_id Int
  room_detail_id  Int
  price_per_night Decimal      @db.Decimal(12, 2)
  nights          Int
  subtotal        Decimal      @db.Decimal(12, 2)
  created_at      DateTime     @default(now())

  booking       user_bookings              @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  room_type     room_types                 @relation(fields: [room_type_id], references: [id])
  room_variant  room_variants              @relation(fields: [room_variant_id], references: [id])
  room_detail   room_details               @relation(fields: [room_detail_id], references: [id])
  nightly_rates room_booking_nightly_rates[]

  @@index([booking_id])
  @@index([room_type_id])
  @@index([room_variant_id])
  @@index([room_detail_id])
  @@map("room_bookings")
}

// ═══════════════════════════════════════════════════════
// ROOM BOOKING NIGHTLY RATES
// One row per booked night, snapshotted from the pricing resolver at the
// moment of booking. This is historical record — it must NEVER be
// recalculated from current pricing_rules/room_variants.price later.
// Pricing can change or a rule can be edited/deleted after the fact; this
// table is what guarantees the guest's original price is preserved
// exactly, regardless of what happens to pricing afterward.
// ═══════════════════════════════════════════════════════

model room_booking_nightly_rates {
  id              Int      @id @default(autoincrement())
  room_booking_id Int
  stay_date       DateTime @db.Date
  price           Decimal  @db.Decimal(12, 2)
  // Snapshot of what produced this price, purely for admin transparency
  // (e.g. showing "Weekend Special applied" on a past booking) — never
  // read by any live calculation, only for display/audit.
  pricing_rule_id   Int?
  pricing_rule_name String?  @db.VarChar(150)
  created_at        DateTime @default(now())

  room_booking room_bookings @relation(fields: [room_booking_id], references: [id], onDelete: Cascade)

  @@unique([room_booking_id, stay_date])
  @@index([room_booking_id])
  @@map("room_booking_nightly_rates")
}

// ═══════════════════════════════════════════════════════
// ROOM TRACKERS  (availability lock)
// One row per physical room per date range.
// @@unique([room_detail_id, check_in, check_out]) prevents double-booking at DB level.
// On EXPIRED/CANCELLED: status updated, row kept for history.
// ═══════════════════════════════════════════════════════

model room_trackers {
  id             Int           @id @default(autoincrement())
  booking_id     Int
  room_detail_id Int
  check_in       DateTime      @db.Date
  check_out      DateTime      @db.Date
  status         TrackerStatus @default(RESERVED)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  booking     user_bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  room_detail room_details  @relation(fields: [room_detail_id], references: [id])

  @@unique([room_detail_id, check_in, check_out, status])
  @@index([room_detail_id, check_in, check_out])
  @@index([booking_id])
  @@index([status])
  @@index([check_in])
  @@map("room_trackers")
}

// ═══════════════════════════════════════════════════════
// BLACKLISTED TOKENS
// JWT invalidation on logout or block.
// Cron purges rows where expires_at < NOW().
// ═══════════════════════════════════════════════════════

model blacklisted_tokens {
  id         Int       @id @default(autoincrement())
  token_hash String    @unique @db.VarChar(500)
  actor_id   Int
  actor_type ActorType
  expires_at DateTime
  created_at DateTime  @default(now())

  @@index([token_hash])
  @@index([expires_at])
  @@index([actor_id, actor_type])
  @@map("blacklisted_tokens")
}

// ═══════════════════════════════════════════════════════
// POLICIES
// Always hotel-owned — no global/default rows (unlike amenities/bed_types).
// Hotel admin authors free-form policies; system admin has read visibility
// only (via the case review flow when a policy is added/changed), no separate
// authoring or approval path of their own.
// ═══════════════════════════════════════════════════════

model policies {
  id          Int       @id @default(autoincrement())
  hotel_id    Int
  name        String    @db.VarChar(150)
  description String    @db.Text
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  hotel hotels @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@index([hotel_id])
  @@map("policies")
}

// ═══════════════════════════════════════════════════════
// HOTEL OWNER DETAILS
// 1:1 with hotels. Owner never logs in — this is identity/legal info only,
// captured by system admin on the Add Hotel form.
// ═══════════════════════════════════════════════════════

model hotel_owner_details {
  id         Int       @id @default(autoincrement())
  hotel_id   Int       @unique
  full_name  String    @db.VarChar(150)
  dob        DateTime? @db.Date
  nid_no     String?   @db.VarChar(50)
  passport   String?   @db.VarChar(50)
  email      String?   @db.VarChar(150)
  phone      String    @db.VarChar(32)
  address    String    @db.Text
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  hotel  hotels                @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  images hotel_owner_images[]

  @@map("hotel_owner_details")
}

model hotel_owner_images {
  id                  Int                 @id @default(autoincrement())
  hotel_owner_detail_id Int
  image_url           String              @db.VarChar(500)
  is_active            Boolean             @default(true)
  created_at           DateTime            @default(now())

  hotel_owner_detail hotel_owner_details @relation(fields: [hotel_owner_detail_id], references: [id], onDelete: Cascade)

  @@index([hotel_owner_detail_id])
  @@map("hotel_owner_images")
}

// ═══════════════════════════════════════════════════════
// HOTEL DOCUMENTS
// Pure file uploads (PDF/JPEG) — no structured metadata fields. One row per
// uploaded document. Every document_type is just a file, including Trade
// License / TIN / VAT / Tax Certificate — no number/date/issuer fields.
// ═══════════════════════════════════════════════════════

model hotel_documents {
  id            Int          @id @default(autoincrement())
  hotel_id      Int
  document_type DocumentType
  file_url      String       @db.VarChar(500)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  hotel hotels @relation(fields: [hotel_id], references: [id], onDelete: Cascade)

  @@index([hotel_id])
  @@index([document_type])
  @@map("hotel_documents")
}

// ═══════════════════════════════════════════════════════
// CASES  (the review/draft pipeline)
// One row per submission event. Only one OPEN (status=PENDING) case per
// hotel is allowed at a time — enforced at the application layer, not by
// a DB constraint, so history of past decided cases is preserved.
// Draft Center unlocks the moment status != PENDING (approved or rejected),
// not on a fixed timer.
// ═══════════════════════════════════════════════════════

model cases {
  id             Int         @id @default(autoincrement())
  hotel_id       Int
  submitted_by   Int         // hotel_admins.id
  status         CaseStatus  @default(DRAFTING)
  summary        String?     @db.Text
  submitted_at   DateTime    @default(now())
  decided_by     Int?        // system_admins.id
  decided_at     DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  hotel         hotels           @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  submitter     hotel_admins     @relation("CaseSubmittedBy", fields: [submitted_by], references: [id])
  decider       system_admins?   @relation("CaseDecidedBy", fields: [decided_by], references: [id])
  field_changes case_field_changes[]

  @@index([hotel_id])
  @@index([status])
  @@index([submitted_by])
  @@map("cases")
}

// ═══════════════════════════════════════════════════════
// CASE FIELD CHANGES
// One row per changed field OR per whole new sub-record proposed within a
// case. field_name = null means "this whole row is a new record" (e.g. a
// brand new room_type or hotel_document) and proposed_value holds the full
// JSON payload for it; entity_id = null in that situation since it doesn't
// exist yet. When field_name is set, entity_id/entity_type point at the
// existing live row being modified, previous_value is what's live now, and
// proposed_value is what's being requested.
// No DB-level FK to the target entity tables (polymorphic across several
// tables) — validated in the API layer against CaseEntityType.
// rejection_reason + decided_at are what surfaces on the Hotel Admin's
// "all my rejections in one place" view.
// ═══════════════════════════════════════════════════════

model case_field_changes {
  id               Int               @id @default(autoincrement())
  case_id          Int
  entity_type      CaseEntityType
  entity_id        Int?
  field_name       String?           @db.VarChar(100)
  previous_value   String?           @db.Text
  proposed_value   String            @db.Text
  status           FieldChangeStatus @default(PENDING)
  rejection_reason String?           @db.Text
  decided_at       DateTime?
  created_at       DateTime          @default(now())

  case cases @relation(fields: [case_id], references: [id], onDelete: Cascade)

  @@index([case_id])
  @@index([status])
  @@index([entity_type, entity_id])
  @@map("case_field_changes")
}

// ═══════════════════════════════════════════════════════
// ACTIVITY LOGS  (one table per actor sector, per your request)
// Hotel Sub-Admin actions are folded into hotel_admin_activity_logs,
// tagged via actor_type, since they only ever act within their hotel's scope.
// No real FK on actor_id (system_admin / end_user tables are single-actor-
// type so it's implicit there; hotel table needs actor_type alongside it).
// ═══════════════════════════════════════════════════════

model system_admin_activity_logs {
  id          Int      @id @default(autoincrement())
  actor_id    Int      // system_admins.id
  action      String   @db.VarChar(150)
  entity_type String   @db.VarChar(100)
  entity_id   Int?
  metadata    Json?
  ip_address  String?  @db.VarChar(64)
  created_at  DateTime @default(now())

  @@index([actor_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("system_admin_activity_logs")
}

model hotel_admin_activity_logs {
  id          Int       @id @default(autoincrement())
  hotel_id    Int
  actor_id    Int       // hotel_admins.id OR hotel_sub_admins.id
  actor_type  ActorType // HOTEL_ADMIN or HOTEL_SUB_ADMIN
  action      String    @db.VarChar(150)
  entity_type String    @db.VarChar(100)
  entity_id   Int?
  metadata    Json?
  ip_address  String?   @db.VarChar(64)
  created_at  DateTime  @default(now())

  @@index([hotel_id])
  @@index([actor_id, actor_type])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("hotel_admin_activity_logs")
}

model end_user_activity_logs {
  id          Int      @id @default(autoincrement())
  actor_id    Int      // end_users.id
  action      String   @db.VarChar(150)
  entity_type String   @db.VarChar(100)
  entity_id   Int?
  metadata    Json?
  ip_address  String?  @db.VarChar(64)
  created_at  DateTime @default(now())

  @@index([actor_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("end_user_activity_logs")
}

// ═══════════════════════════════════════════════════════
// NOTIFICATIONS  (one table per recipient sector, per your request)
// Hotel Sub-Admin notifications fold into hotel_admin_notifications via
// recipient_type, mirroring the activity log decision.
// ═══════════════════════════════════════════════════════

model system_admin_notifications {
  id                 Int              @id @default(autoincrement())
  recipient_id       Int              // system_admins.id
  type               NotificationType
  title              String           @db.VarChar(200)
  message            String           @db.Text
  related_entity_type String?        @db.VarChar(100)
  related_entity_id  Int?
  is_read            Boolean          @default(false)
  created_at         DateTime         @default(now())

  @@index([recipient_id, is_read])
  @@index([created_at])
  @@map("system_admin_notifications")
}

model hotel_admin_notifications {
  id                   Int              @id @default(autoincrement())
  recipient_id         Int              // hotel_admins.id OR hotel_sub_admins.id
  recipient_type       ActorType        // HOTEL_ADMIN or HOTEL_SUB_ADMIN
  type                 NotificationType
  title                String           @db.VarChar(200)
  message              String           @db.Text
  related_entity_type  String?          @db.VarChar(100)
  related_entity_id    Int?
  is_read              Boolean          @default(false)
  created_at           DateTime         @default(now())

  @@index([recipient_id, recipient_type, is_read])
  @@index([created_at])
  @@map("hotel_admin_notifications")
}

model end_user_notifications {
  id                   Int              @id @default(autoincrement())
  recipient_id         Int              // end_users.id
  type                 NotificationType
  title                String           @db.VarChar(200)
  message              String           @db.Text
  related_entity_type  String?          @db.VarChar(100)
  related_entity_id    Int?
  is_read              Boolean          @default(false)
  created_at           DateTime         @default(now())

  @@index([recipient_id, is_read])
  @@index([created_at])
  @@map("end_user_notifications")
}